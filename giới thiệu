import 'package:flutter/material.dart';

void main() {
runApp(const MyApp());
}

class Member {
final String name;
final String role;
final String description;
final String imageUrl;
final String email;

Member({
required this.name,
required this.role,
required this.description,
required this.imageUrl,
required this.email,
});
}

class MyApp extends StatelessWidget {
const MyApp({super.key});

@OverRide
Widget build(BuildContext context) {
return MaterialApp(
title: 'Team App',
debugShowCheckedModeBanner: false,
theme: ThemeData(
useMaterial3: true,
colorSchemeSeed: Colors.blue,
),
home: const HomePage(),
);
}
}

class HomePage extends StatelessWidget {
const HomePage({super.key});

List get members => [
Member(
name: "Trần Duy Minh",
role: "Leader",
description: "Quản lý dự án, định hướng phát triển nhóm.",
imageUrl: "https://iili.io/Fiv82OQ.jpg",
email: "duyminh1@gmail.com",
),
Member(
name: "Vũ Quang Minh",
role: "Developer",
description: "Lập trình Flutter và backend.",
imageUrl: "https://iili.io/Fivken9.jpg",
email: "quangminh@gmail.com",
),
Member(
name: "Nguyễn Quang Tú",
